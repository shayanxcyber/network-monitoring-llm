[Unit]
Description=PacketPilot isolated lab response broker
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -E -s /usr/local/lib/packetpilot-response/pp_response_broker.py
Restart=on-failure
RestartSec=1
KillMode=control-group
TimeoutStopSec=15
UMask=0077
WorkingDirectory=/var/lib/packetpilot-response
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
