{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:packetpilot:assessment-schema:2.1",
  "$comment": "Response format 2.0; schema revision 2.1 permits actual field names such as ipv4 and protocol_counts.TCP. Values still require exact supplied-field validation.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "capture_sha256", "assessment", "summary", "observations", "interpretation", "alternatives", "uncertainty", "coverage", "measurements", "recommendations", "questions"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "capture_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assessment": {"enum": ["normal_observations", "suspicious_observations", "inconclusive"]},
    "summary": {"$ref": "#/$defs/text"},
    "observations": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["text", "references"], "properties": {"text": {"$ref": "#/$defs/text"}, "references": {"$ref": "#/$defs/refs"}}}},
    "interpretation": {"$ref": "#/$defs/text"},
    "alternatives": {"$ref": "#/$defs/texts"},
    "uncertainty": {"allOf": [{"$ref": "#/$defs/texts"}], "minItems": 1},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["status", "limitations"], "properties": {"status": {"enum": ["complete_supported", "partial"]}, "limitations": {"allOf": [{"$ref": "#/$defs/texts"}], "minItems": 1}}},
    "measurements": {"type": "array", "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["reference", "field", "value"], "properties": {"reference": {"type": "string", "maxLength": 100}, "field": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$", "maxLength": 120}, "value": {"type": ["number", "string", "boolean"], "maxLength": 120}}}},
    "recommendations": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["action", "target", "duration_seconds", "rationale", "references"], "properties": {"action": {"enum": ["investigate", "no_action", "block_source"]}, "target": {"type": ["string", "null"], "maxLength": 15}, "duration_seconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 120}, "rationale": {"$ref": "#/$defs/text"}, "references": {"$ref": "#/$defs/refs"}}}},
    "questions": {"$ref": "#/$defs/texts"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 1400},
    "texts": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "refs": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}}
  }
}
