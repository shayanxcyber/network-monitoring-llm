# Example only: this file is not loaded automatically.
# The web application uses settings.toml and configure_key.py.
# DEEPSEEK_API_KEY can alternatively supply its key through the environment.
DEEPSEEK_API_KEY=
# The following optional variables are for the command-line API client.
PACKETPILOT_API_BASE_URL=https://api.deepseek.com
PACKETPILOT_MODEL=deepseek-flash
PACKETPILOT_API_KEY=
PACKETPILOT_API_TIMEOUT=300
# Current DeepSeek diagnostic settings; omit provider-specific options for other providers.
PACKETPILOT_THINKING=enabled
PACKETPILOT_REASONING_EFFORT=max
# Leave blank to omit the optional generation override.
PACKETPILOT_MAX_OUTPUT_TOKENS=
