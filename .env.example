# Example only: this file is NOT loaded or executed by the application.
# Terminal API mode reads these variables from the process environment.
PACKETPILOT_API_BASE_URL=https://api.deepseek.com
PACKETPILOT_MODEL=
PACKETPILOT_API_KEY=
PACKETPILOT_API_TIMEOUT=25
# DeepSeek supports this option; leave blank for providers without it.
PACKETPILOT_THINKING=disabled

# Browser/Agno mode uses settings.toml for non-secret provider/model settings.
# Use configure_key.py to save its key privately outside this repository,
# or set DEEPSEEK_API_KEY in the process environment. Never commit a real key.
